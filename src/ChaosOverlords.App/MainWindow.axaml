<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ChaosOverlords.App.ViewModels"
        xmlns:views="clr-namespace:ChaosOverlords.App.Views"
        xmlns:finance="clr-namespace:ChaosOverlords.App.Views.Finance"
        mc:Ignorable="d"
        d:DesignWidth="1024"
        d:DesignHeight="768"
        d:DataContext="{d:DesignInstance vm:MainViewModel, IsDesignTimeCreatable=False}"
        x:DataType="vm:MainViewModel"
        x:Class="ChaosOverlords.App.MainWindow"
        Title="Chaos Overlords">
    <DockPanel>
        <!-- Placeholder for upcoming menu bar integration -->
        <Menu DockPanel.Dock="Top" IsVisible="False" />

        <!-- Footer with Finance HUD indicator -->
        <Border DockPanel.Dock="Bottom"
                Padding="4"
                Background="#111"
                BorderBrush="#333"
                BorderThickness="1,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <finance:FinanceHUDIndicatorView DataContext="{Binding Turn.FinanceHud}"/>
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="3*,2*,1.5*">
            <views:MapView DataContext="{Binding Map}" Margin="8" />
            <views:TurnView DataContext="{Binding Turn}" Margin="8" Grid.Column="1" />
            <views:EventFeedPanel DataContext="{Binding EventFeed}" Margin="8" Grid.Column="2" />
        </Grid>
    </DockPanel>
</Window>