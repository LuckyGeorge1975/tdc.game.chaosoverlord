<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sections="clr-namespace:ChaosOverlords.App.ViewModels.Finance"
        x:Class="ChaosOverlords.App.Views.Finance.CityFinancialDialogView"
        Width="480" Height="420"
        Title="City Financial"
        x:DataType="sections:CityFinancialDialogViewModel">
  <DockPanel Margin="8" LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="0 0 0 8">
      <TextBlock Text="City Financial" FontSize="18" FontWeight="Bold"/>
      <TextBlock Text="{Binding PlayerName}" VerticalAlignment="Center"/>
      <Button Content="Refresh" Command="{Binding ForceRefreshCommand}"/>
      <TextBlock Text="Net:" Margin="16 0 0 0" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding Net}" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding CityCategories}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,80" Margin="0 2">
              <TextBlock Text="{Binding DisplayName}"/>
              <TextBlock Grid.Column="1" Text="{Binding Amount}" HorizontalAlignment="Right">
                <TextBlock.Styles>
                  <Style Selector="TextBlock">
                    <Setter Property="Foreground" Value="White"/>
                  </Style>
                  <Style Selector="TextBlock:pointerover">
                    <Setter Property="Foreground" Value="#ddd"/>
                  </Style>
                </TextBlock.Styles>
              </TextBlock>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
    <DockPanel DockPanel.Dock="Bottom" Margin="0 8 0 0">
      <Button Content="Close" HorizontalAlignment="Right" Width="80" Click="OnCloseClick"/>
    </DockPanel>
  </DockPanel>
</Window>
